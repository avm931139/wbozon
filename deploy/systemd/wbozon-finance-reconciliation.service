[Unit]
Description=wbozon cabinet financial reports reconciliation
After=network-online.target postgresql.service wbozon-telegram-relay.service
Wants=network-online.target

[Service]
Type=oneshot
User=wbozon
Group=wbozon
WorkingDirectory=/home/wbozon/wbozon
EnvironmentFile=/home/wbozon/wbozon/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/wbozon/wbozon/.venv/bin/python -m finance_reconciliation
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
