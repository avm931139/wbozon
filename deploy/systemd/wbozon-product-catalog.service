[Unit]
Description=wbozon normalized product cards and local media storage
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wbozon
Group=wbozon
WorkingDirectory=/home/wbozon/wbozon
EnvironmentFile=/home/wbozon/wbozon/.env
ExecStart=/home/wbozon/wbozon/.venv/bin/python -m product_catalog

[Install]
WantedBy=multi-user.target
