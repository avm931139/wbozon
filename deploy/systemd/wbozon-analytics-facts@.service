[Unit]
Description=wbozon normalized financial sales facts for %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wbozon
Group=wbozon
WorkingDirectory=/home/wbozon/wbozon
EnvironmentFile=/home/wbozon/wbozon/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/wbozon/wbozon/.venv/bin/python -m analytics_facts --marketplace %i
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=yes
