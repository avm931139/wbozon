[Unit]
Description=Initialize or inspect the encrypted wbozon backup repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wbozon
Group=wbozon
WorkingDirectory=/home/wbozon/wbozon
EnvironmentFile=/home/wbozon/wbozon/.env
EnvironmentFile=/etc/wbozon/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/wbozon/wbozon/.venv/bin/python -m backup init
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/wbozon /home/wbozon/wbozon/data/backup
