# This file is installed as /etc/wbozon/backup.env with mode 0600.
# Never commit the real file or the restic password.

# Supported off-site destinations include SFTP, S3, B2 and an authenticated
# REST server. Example: sftp:backup@example.net:/srv/restic/wbozon
RESTIC_REPOSITORY=sftp:backup@example.net:/srv/restic/wbozon
RESTIC_PASSWORD_FILE=/etc/wbozon/restic-password

BACKUP_PROJECT_DIR=/home/wbozon/wbozon
BACKUP_STAGING_DIR=/var/backups/wbozon
BACKUP_STATUS_DIR=/home/wbozon/wbozon/data/backup
BACKUP_DATA_PATHS=data,/etc/wbozon/backup.env
BACKUP_REQUIRE_OFFSITE=true
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_CHECK_SUBSET=5%

# Dedicated disposable database. It must never equal DATABASE_URL and its
# name must contain restore, backup or test.
BACKUP_VERIFY_DATABASE_URL=postgresql+psycopg://wbozon:CHANGE_ME@localhost:5432/wbozon_restore_test
