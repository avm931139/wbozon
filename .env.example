DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database
WB_API_KEY=your_wildberries_api_key
WB_CONTENT_BASE_URL=https://content-api.wildberries.ru
WB_MARKETPLACE_BASE_URL=https://marketplace-api.wildberries.ru
WB_ANALYTICS_BASE_URL=https://seller-analytics-api.wildberries.ru
WB_STATISTICS_BASE_URL=https://statistics-api.wildberries.ru
WB_SUPPLIES_BASE_URL=https://supplies-api.wildberries.ru
WB_FINANCE_BASE_URL=https://finance-api.wildberries.ru
WB_FEEDBACKS_BASE_URL=https://feedbacks-api.wildberries.ru
WB_PROMOTION_BASE_URL=https://advert-api.wildberries.ru
# Optional: if omitted, WB_API_KEY is used.
WB_PROMOTION_API_KEY=
WB_QUESTION_RESPONSE_SLA_HOURS=24
WB_FEEDBACK_RESPONSE_SLA_HOURS=24
WB_TIMEOUT_SECONDS=30

# Periodic full WB synchronization. Default: every 6 hours.
WB_SYNC_INTERVAL_SECONDS=21600
# Run the first cycle immediately after process startup.
WB_SYNC_RUN_ON_START=true
# Earliest date for the first/history-based synchronization.
WB_SYNC_HISTORY_START=2019-01-01
# Reload this many calendar days of advertising data each cycle.
WB_SYNC_PROMOTION_LOOKBACK_DAYS=31
# Reload recent FBS orders to catch status/data changes.
WB_SYNC_FBS_ORDER_OVERLAP_DAYS=2
# Reload recent finance rows to catch corrections and returns.
WB_SYNC_FINANCE_OVERLAP_DAYS=7

# Independent WB/Ozon current inventory refresh and daily snapshots.
# Server timezone does not matter: daily snapshots use Europe/Moscow explicitly.
INVENTORY_SYNC_INTERVAL_SECONDS=3600
INVENTORY_SNAPSHOT_TIME=01:00
INVENTORY_TIMEZONE=Europe/Moscow
INVENTORY_SYNC_RUN_ON_START=true

# WB scheduler logs and rotation.
WB_LOG_DIR=logs/wb
WB_LOG_LEVEL=INFO
WB_LOG_MAX_BYTES=10485760
WB_LOG_BACKUP_COUNT=10

# Telegram group reports. Add the bot to the group and use its negative chat ID.
WB_TG_BOT_TOKEN=123456789:replace_with_botfather_token
WB_TG_CHAT_ID=-1001234567890
WB_TG_TIMEZONE=Europe/Moscow
# Daily report for yesterday and the current month through yesterday.
WB_TG_MORNING_TIME=09:00
# Current situation report every 3 hours.
WB_TG_OPERATIONAL_INTERVAL_SECONDS=10800
WB_TG_POLL_SECONDS=30
WB_TG_REQUEST_TIMEOUT_SECONDS=30
WB_TG_LOW_STOCK_THRESHOLD=5

# Ozon Seller API. Both credentials are required for Ozon synchronization.
OZON_CLIENT_ID=replace_with_seller_client_id
OZON_API_KEY=replace_with_ozon_api_key
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_TIMEOUT_SECONDS=30
# Full Ozon synchronization every 6 hours.
OZON_SYNC_INTERVAL_SECONDS=21600
OZON_SYNC_RUN_ON_START=true
# Reload recent FBS/FBO postings to catch status changes.
OZON_ORDER_LOOKBACK_DAYS=30
# Initial history boundary for supplies, daily sales and finance.
OZON_HISTORY_FROM=2026-01-01
OZON_SYNC_OVERLAP_DAYS=3

# Separate credentials from Promotion -> Settings -> Performance API.
OZON_PERFORMANCE_CLIENT_ID=replace_with_performance_client_id
OZON_PERFORMANCE_CLIENT_SECRET=replace_with_performance_client_secret
OZON_PERFORMANCE_BASE_URL=https://api-performance.ozon.ru
